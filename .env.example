# Copy to .env and fill in from your Supabase project:
# Dashboard > Project Settings > API
#
# Both values are safe to expose in the browser bundle — NEXT_PUBLIC_* is
# inlined at build time by design, and the anon key is only as powerful as the
# row-level security policies in supabase/migrations allow.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run the Supabase CLI against the remote project
# (gen types, db push, migration list). Never deploy this — it is an
# account-level credential, not a runtime variable.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
